{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Staging",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run Staging Profile",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run Staging Release",
            "request": "launch",
            "flutterMode": "release",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run Prod",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "Run Prod Profile",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "Webpage",
            "request": "launch",
            "type": "chrome",
            "url": "file:///${workspaceFolder}/web/index.html"
        }
    ]
}