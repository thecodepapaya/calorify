{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Staging",
            "request": "launch",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run Staging Profile",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run Staging Release",
            "request": "launch",
            "flutterMode": "release",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run Prod",
            "request": "launch",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "Run Prod Profile",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "Webpage",
            "request": "launch",
            "type": "chrome",
            "url": "file:///${workspaceFolder}/web/index.html"
        },
        {
            "name": "Watch App (Debug)",
            "request": "launch",
            "type": "dart",
            "program": "watch_app/lib/main.dart"
        },
        {
            "name": "Watch App (Profile)",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "program": "watch_app/lib/main.dart"
        },
        {
            "name": "Backend: Run Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/cmd/server/main.go",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "ENVIRONMENT": "development"
            },
            "preLaunchTask": "infrastructure_start_docker"
        },
        {
            "name": "Backend: Run Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/backend/...",
            "cwd": "${workspaceFolder}/backend"
        }
    ]
}