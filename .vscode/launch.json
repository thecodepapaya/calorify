{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run dev (mock db)",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}/app/calorify",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "dev"
            ]
        },
        {
            "name": "Run dev",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}/app/calorify",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "dev",
                "--dart-define=USE_REAL_DATABASE=true"
            ]
        },
        {
            "name": "Run staging",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}/app/calorify",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run staging profile",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "cwd": "${workspaceFolder}/app/calorify",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run prod",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}/app/calorify",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "Run prod profile",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "cwd": "${workspaceFolder}/app/calorify",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "Webpage",
            "request": "launch",
            "type": "chrome",
            "url": "file:///${workspaceFolder}/web/index.html"
        },
        {
            "name": "Watch App (Debug)",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}/app/watch",
            "program": "lib/main.dart"
        },
        {
            "name": "Watch App (Profile)",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "cwd": "${workspaceFolder}/app/watch",
            "program": "lib/main.dart"
        },
        {
            "name": "Backend: Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/cmd/server",
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/.env"
        },
        {
            "name": "Backend: USDA CLI",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/cmd/usda",
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/.env"
        }
    ]
}
