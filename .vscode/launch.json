{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Staging",
            "request": "launch",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run Staging Profile",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run Staging Release",
            "request": "launch",
            "flutterMode": "release",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run Prod",
            "request": "launch",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "Run Prod Profile",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "Webpage",
            "request": "launch",
            "type": "chrome",
            "url": "file:///${workspaceFolder}/web/index.html"
        },
        {
            "name": "Watch App (Debug)",
            "request": "launch",
            "type": "dart",
            "program": "watch_app/lib/main.dart"
        },
        {
            "name": "Watch App (Profile)",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "program": "watch_app/lib/main.dart"
        },
        {
            "name": "Backend: Dev",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "ENVIRONMENT": "development"
            },
            "python": "${workspaceFolder}/backend/venv/bin/python",
            "console": "integratedTerminal"
        },
        {
            "name": "Backend: Staging",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "ENVIRONMENT": "staging"
            },
            "python": "${workspaceFolder}/backend/venv/bin/python",
            "console": "integratedTerminal"
        },
        {
            "name": "Backend: Prod",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "ENVIRONMENT": "production"
            },
            "python": "${workspaceFolder}/backend/venv/bin/python",
            "console": "integratedTerminal"
        }
    ]
}