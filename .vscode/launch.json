{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Staging",
            "request": "launch",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run Staging (Localhost)",
            "request": "launch",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "staging",
                "--dart-define=USE_LOCAL_BACKEND=true"
            ]
        },
        {
            "name": "Run Staging Profile",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run Staging Release",
            "request": "launch",
            "flutterMode": "release",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run Prod",
            "request": "launch",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "Run Prod Profile",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "program": "app/lib/main.dart",
            "args": [
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "Webpage",
            "request": "launch",
            "type": "chrome",
            "url": "file:///${workspaceFolder}/web/index.html"
        },
        {
            "name": "Watch App (Debug)",
            "request": "launch",
            "type": "dart",
            "program": "watch_app/lib/main.dart"
        },
        {
            "name": "Watch App (Profile)",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "program": "watch_app/lib/main.dart"
        },
        {
            "name": "Backend: Dev",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "${workspaceFolder}/backend/node_modules/.bin/tsx",
            "runtimeArgs": [
                "watch",
                "src/index.ts"
            ],
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "ENVIRONMENT": "development",
                "DATABASE_URL": "postgresql://calorify:calorify_pwd_staging@localhost:5433/calorify_staging"
            },
            "preLaunchTask": "start-db-staging",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/backend/**",
                "!**/node_modules/**"
            ],
            "sourceMaps": true,
            "outputCapture": "std"
        },
        {
            "name": "Backend: Staging",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "${workspaceFolder}/backend/node_modules/.bin/tsx",
            "runtimeArgs": [
                "src/index.ts"
            ],
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "ENVIRONMENT": "staging"
            },
            "envFile": "${workspaceFolder}/backend/staging.env",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/backend/**",
                "!**/node_modules/**"
            ],
            "sourceMaps": true,
            "outputCapture": "std"
        },
        {
            "name": "Backend: Prod",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "program": "${workspaceFolder}/backend/dist/index.js",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "ENVIRONMENT": "production"
            },
            "envFile": "${workspaceFolder}/backend/production.env",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "outputCapture": "std",
            "preLaunchTask": "build-backend"
        }
    ]
}