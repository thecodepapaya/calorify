{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run dev (mock db)",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}/app",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "dev"
            ]
        },
        {
            "name": "Run dev",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}/app",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "dev",
                "--dart-define=USE_REAL_DATABASE=true"
            ]
        },
        {
            "name": "Run staging",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}/app",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run staging profile",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "cwd": "${workspaceFolder}/app",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "staging"
            ]
        },
        {
            "name": "Run prod",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}/app",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "Run prod profile",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "cwd": "${workspaceFolder}/app",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "Webpage",
            "request": "launch",
            "type": "chrome",
            "url": "file:///${workspaceFolder}/web/index.html"
        },
        {
            "name": "Watch App (Debug)",
            "request": "launch",
            "type": "dart",
            "program": "watch_app/lib/main.dart"
        },
        {
            "name": "Watch App (Profile)",
            "request": "launch",
            "flutterMode": "profile",
            "type": "dart",
            "program": "watch_app/lib/main.dart"
        },
        {
            "name": "Backend: Dev",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "${workspaceFolder}/backend/node_modules/.bin/tsx",
            "runtimeArgs": [
                "watch",
                "src/index.ts"
            ],
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "ENVIRONMENT": "development"
            },
            "envFile": "${workspaceFolder}/backend/.env",
            "preLaunchTask": "start-db-staging",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/backend/**",
                "!**/node_modules/**"
            ],
            "sourceMaps": true,
            "outputCapture": "std"
        },
        {
            "name": "Backend: Staging",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "${workspaceFolder}/backend/node_modules/.bin/tsx",
            "runtimeArgs": [
                "src/index.ts"
            ],
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "ENVIRONMENT": "staging"
            },
            "envFile": "${workspaceFolder}/backend/staging.env",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/backend/**",
                "!**/node_modules/**"
            ],
            "sourceMaps": true,
            "outputCapture": "std"
        },
        {
            "name": "Backend: Prod",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "program": "${workspaceFolder}/backend/dist/index.js",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "ENVIRONMENT": "production"
            },
            "envFile": "${workspaceFolder}/backend/production.env",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "outputCapture": "std",
            "preLaunchTask": "build-backend"
        }
    ]
}
