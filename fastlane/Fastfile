default_platform(:android)

platform :android do
  package_name = "dev.thecodepapaya.calorify"

  private_lane :pubspec_version_code do |options|
    repository_root = File.expand_path("..", __dir__)
    path = File.expand_path(options.fetch(:path), repository_root)
    match = File.read(path).match(/^version:\s*\d+\.\d+\.\d+\+(\d+)\s*$/)
    UI.user_error!("Could not read an Android version code from #{path}") unless match

    Integer(match[1], 10)
  end

  private_lane :promote_existing_release do |options|
    source_track = options.fetch(:source_track)
    target_track = options.fetch(:target_track)
    expected_version_code = options.fetch(:expected_version_code)

    UI.user_error!("Source and target tracks must differ") if source_track == target_track

    source_version_codes = google_play_track_version_codes(
      track: source_track,
      json_key_data: ENV["SUPPLY_JSON_KEY_DATA"],
      package_name: package_name
    ).map(&:to_i)

    unless source_version_codes.include?(expected_version_code)
      candidate_tracks = ["internal", "beta", "production", "wear:internal", "wear:beta", "wear:production"]
      matching_tracks = candidate_tracks.reject { |track| track == source_track }.filter_map do |track|
        version_codes = google_play_track_version_codes(
          track: track,
          json_key_data: ENV["SUPPLY_JSON_KEY_DATA"],
          package_name: package_name
        ).map(&:to_i)
        track if version_codes.include?(expected_version_code)
      rescue StandardError => error
        UI.important("Could not inspect #{track}: #{error.message}")
        nil
      end

      location_hint = if matching_tracks.empty?
                        "It is not active on any standard phone or Wear OS track."
                      else
                        "It is active on: #{matching_tracks.join(', ')}."
                      end
      UI.user_error!(
        "Expected version code #{expected_version_code} on #{source_track}, " \
        "but found: #{source_version_codes.join(', ')}. #{location_hint}"
      )
    end

    upload_to_play_store(
      track: source_track,
      track_promote_to: target_track,
      track_promote_release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      version_code: expected_version_code,
      json_key_data: ENV["SUPPLY_JSON_KEY_DATA"],
      package_name: package_name,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc "Fail before building when an Android version code cannot be uploaded"
  lane :validate_version_code do
    candidate = pubspec_version_code(
      path: ENV.fetch("PLAY_PUBSPEC_PATH")
    )
    tracks = ["internal", "beta", "production", "wear:internal", "wear:beta", "wear:production"]
    inspected_tracks = 0
    active_codes = tracks.flat_map do |track|
      codes = google_play_track_version_codes(
        track: track,
        json_key_data: ENV["SUPPLY_JSON_KEY_DATA"],
        package_name: package_name
      ).map(&:to_i)
      inspected_tracks += 1
      UI.message("#{track}: #{codes.empty? ? 'no active releases' : codes.join(', ')}")
      codes
    rescue StandardError => error
      UI.important("Could not inspect #{track}: #{error.message}")
      []
    end.uniq

    UI.user_error!("Could not inspect any Google Play tracks") if inspected_tracks.zero?

    maximum = active_codes.max
    if active_codes.include?(candidate)
      UI.user_error!("Version code #{candidate} is already active on Google Play")
    end
    if maximum && candidate <= maximum
      UI.user_error!(
        "Version code #{candidate} must be greater than the highest active phone/Wear OS code #{maximum}"
      )
    end

    UI.success("Version code #{candidate} is available for upload")
  end

  desc "Draft English Google Play release notes"
  lane :release_notes do
    sh("./scripts/generate_release_notes.sh")
  end

  private_lane :validate_play_release_notes do
    repository_root = File.expand_path("..", __dir__)
    version_code = pubspec_version_code(path: "app/pubspec.yaml")
    path = File.join(repository_root, "fastlane/metadata/android/en-US/changelogs/#{version_code}.txt")
    UI.user_error!("Missing English Play changelog: #{path}") unless File.file?(path)

    text = File.read(path, encoding: "UTF-8")
    lines = text.lines(chomp: true)
    UI.user_error!("English Play changelog must contain 1 to 4 nonempty lines") unless
      lines.length.between?(1, 4) && lines.none?(&:empty?)
    UI.user_error!("English Play changelog lines must start with '- '") unless
      lines.all? { |line| line.start_with?("- ") && line.length > 12 }
    UI.user_error!("English Play changelog exceeds 500 characters") if text.chomp.length > 500
    UI.user_error!("English Play changelog contains unsupported characters") unless
      text.ascii_only? && text.match?(/\A[\x20-\x7E\n]+\z/) && !text.match?(/[<>]/)
  end

  desc "Deploy a new version to the Google Play"
  lane :release do
    track = ENV.fetch("PLAY_TRACK", "internal")
    validate_play_release_notes

    upload_to_play_store(
      track: track,
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      aab: "app/build/app/outputs/bundle/prodRelease/app-prod-release.aab",
      json_key_data: ENV["SUPPLY_JSON_KEY_DATA"],
      package_name: package_name,
      metadata_path: "fastlane/metadata/android",
      # Store listings are managed in Play Console. This lane uploads only the
      # English changelog, so Fastlane must not create incomplete locale listings.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote an existing phone release between Google Play tracks"
  lane :promote_phone do
    promote_existing_release(
      source_track: ENV.fetch("PLAY_SOURCE_TRACK", "internal"),
      target_track: ENV.fetch("PLAY_TARGET_TRACK", "production"),
      expected_version_code: Integer(ENV.fetch("PLAY_EXPECTED_VERSION_CODE"), 10)
    )
  end

end
