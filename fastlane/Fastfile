default_platform(:android)

platform :android do
  desc "Draft and translate Google Play release notes"
  lane :release_notes do
    sh("./scripts/generate_release_notes.sh")
  end

  desc "Deploy a new version to the Google Play"
  lane :release do    
    # Upload Main App to Production
    upload_to_play_store(
      track: ENV.fetch("PLAY_TRACK", "production"),
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      aab: "app/build/app/outputs/bundle/prodRelease/app-prod-release.aab",
      json_key_data: ENV["SUPPLY_JSON_KEY_DATA"],
      package_name: "dev.thecodepapaya.calorify",
      metadata_path: "fastlane/metadata/android"
    )

  end

  desc "Deploy watch app bundle to Google Play"
  lane :release_watch do
    upload_to_play_store(
      track: ENV.fetch("PLAY_TRACK", "production"),
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      aab: "watch_app/build/app/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["SUPPLY_JSON_KEY_DATA"],
      package_name: "dev.thecodepapaya.calorify",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end
