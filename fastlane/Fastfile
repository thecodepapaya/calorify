default_platform(:android)

platform :android do
  package_name = "dev.thecodepapaya.calorify"

  private_lane :form_factor_track do |options|
    base_track = options[:track] == "internal" ? "qa" : options[:track]
    "#{options[:prefix]}:#{base_track}"
  end

  desc "Draft and translate Google Play release notes"
  lane :release_notes do
    sh("./scripts/generate_release_notes.sh")
  end

  desc "Deploy a new version to the Google Play"
  lane :release do
    track = ENV.fetch("PLAY_TRACK", "production")

    upload_to_play_store(
      track: track,
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      aab: "app/build/app/outputs/bundle/prodRelease/app-prod-release.aab",
      json_key_data: ENV["SUPPLY_JSON_KEY_DATA"],
      package_name: package_name,
      metadata_path: "fastlane/metadata/android"
    )
  end

  desc "Deploy watch app bundle to Google Play"
  lane :release_watch do
    track = form_factor_track(
      prefix: "wear",
      track: ENV.fetch("PLAY_TRACK", "production")
    )

    upload_to_play_store(
      track: track,
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      aab: "watch_app/build/app/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["SUPPLY_JSON_KEY_DATA"],
      package_name: package_name,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc "Promote an existing watch release between Google Play Wear OS tracks"
  lane :promote_watch do
    source_track = form_factor_track(
      prefix: "wear",
      track: ENV.fetch("PLAY_SOURCE_TRACK", "internal")
    )
    target_track = form_factor_track(
      prefix: "wear",
      track: ENV.fetch("PLAY_TARGET_TRACK", "production")
    )
    expected_version_code = Integer(ENV.fetch("PLAY_EXPECTED_VERSION_CODE"), 10)

    UI.user_error!("Source and target tracks must differ") if source_track == target_track

    source_version_codes = google_play_track_version_codes(
      track: source_track,
      json_key_data: ENV["SUPPLY_JSON_KEY_DATA"],
      package_name: package_name
    ).map(&:to_i)

    unless source_version_codes.include?(expected_version_code)
      UI.user_error!(
        "Expected version code #{expected_version_code} on #{source_track}, " \
        "but found: #{source_version_codes.join(', ')}"
      )
    end

    upload_to_play_store(
      track: source_track,
      track_promote_to: target_track,
      track_promote_release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      version_code: expected_version_code,
      json_key_data: ENV["SUPPLY_JSON_KEY_DATA"],
      package_name: package_name,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end
