default_platform(:android)

platform :android do
  desc "Generate translations using Slang GPT"
  lane :translations do
    sh("../scripts/generate_translations.sh")
  end

  desc "Deploy a new version to the Google Play"
  lane :release do
    translations
    
    upload_to_play_store(
      track: "production", # or 'internal', 'beta'
      aab: "app/build/app/outputs/bundle/prodRelease/app-prod-release.aab",
      json_key_data: ENV["SUPPLY_JSON_KEY_DATA"],
      package_name: "dev.thecodepapaya.calorify",
      metadata_path: "fastlane/metadata/android"
    )
  end
end
