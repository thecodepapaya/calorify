# Local OpenAI key for scripts (see scripts/resolve_openai_api_key.py)
scripts/.openai_api_key

# Backend runtime secrets (use backend/env.example as the template)
backend/.env
backend/production.env
backend/staging.env
backend/firebase-adminsdk.json

# Secrets and signing material (examples remain tracked)
**/.env
**/.env.*
!**/.env.example
!**/env.example
**/firebase-adminsdk*.json
**/*service-account*.json
**/key.properties
**/*.jks
**/*.p12
**/*.pem
**/*.key

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/
.vscode/settings.json

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Golden test generated images
app/test/golden/failures/
.release-artifacts/
