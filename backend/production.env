# Production Environment Variables
APP_NAME=CalorifyBackend
DEBUG=False
ENVIRONMENT=production
API_V1_STR=/api/v1
SECRET_KEY=generate-a-secure-secret-key-prod
PORT=8000

# Database Configuration
# Points to the 'db-prod' service defined in docker-compose.yml
DATABASE_URL=postgresql://calorify:calorify_pwd_prod@db-prod:5432/calorify_prod

# Firebase Configuration
# This matches the volume mount in docker-compose.yml
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# Google Gemini AI
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
