{
    "name": "calorify-backend",
    "version": "1.0.4",
    "description": "Calorify Backend API - Node.js/Fastify implementation",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "test": "node --test --test-concurrency=1 --experimental-test-module-mocks --import tsx --disable-warning=ExperimentalWarning 'tests/**/*.test.ts'",
        "test:coverage": "c8 --all --include='src/**/*.ts' --exclude='src/protos/**' --exclude='src/scripts/**' --exclude='src/index.ts' --reporter=text --reporter=lcov --check-coverage --lines=80 --branches=70 --functions=80 --statements=80 npm test",
        "lint": "eslint src tests --ext .ts",
        "type-check": "tsc --noEmit",
        "meal-analysis:eval": "tsx src/scripts/meal-analysis-eval.ts",
        "meal-analysis": "tsx src/scripts/meal-analysis-cli.ts",
        "meal-analysis:local": "bash scripts/meal-analysis-local.sh",
        "push-banner": "tsx src/scripts/push-banner.ts",
        "usda:refresh": "tsx src/scripts/usda-refresh.ts",
        "usda:migrate": "tsx src/scripts/usda-migrate.ts",
        "usda:bootstrap": "tsx src/scripts/usda-bootstrap.ts",
        "usda:lookup": "tsx src/scripts/usda-lookup-cli.ts"
    },
    "keywords": [
        "calorify",
        "backend",
        "api",
        "fastify"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@fastify/cors": "^9.0.1",
        "@fastify/helmet": "^11.1.1",
        "@fastify/rate-limit": "^9.1.0",
        "@fastify/swagger": "^8.13.0",
        "@fastify/swagger-ui": "^2.1.0",
        "csv-parse": "^5.5.6",
        "dotenv": "^16.4.5",
        "fastify": "^4.26.2",
        "firebase-admin": "^14.3.0",
        "openai": "^7.9.0",
        "pg": "^8.11.3",
        "prom-client": "^15.1.3",
        "zod": "^3.25.76",
        "zod-to-json-schema": "^3.25.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^20.14.12",
        "@types/pg": "^8.11.0",
        "@typescript-eslint/eslint-plugin": "^8.69.0",
        "@typescript-eslint/parser": "^8.69.0",
        "c8": "^12.0.0",
        "eslint": "^10.9.1",
        "globals": "^17.12.0",
        "pino-pretty": "^11.2.2",
        "ts-proto": "2.11.0",
        "tsx": "^4.16.2",
        "typescript": "^5.5.4"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
