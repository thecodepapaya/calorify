{
    "name": "calorify-backend",
    "version": "1.0.2",
    "description": "Calorify Backend API - Node.js/Fastify implementation",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "test": "tsx --test src/**/*.test.ts",
        "lint": "eslint src --ext .ts",
        "type-check": "tsc --noEmit",
        "usda:import": "tsx src/scripts/import-usda.ts",
        "usda:refresh": "tsx src/scripts/usda-refresh.ts",
        "usda:bootstrap": "tsx src/scripts/usda-bootstrap.ts",
        "docker:up:staging": "docker compose --profile staging up -d --build",
        "docker:up:prod": "docker compose --profile production up -d --build"
    },
    "keywords": [
        "calorify",
        "backend",
        "api",
        "fastify"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@fastify/cors": "^9.0.1",
        "@fastify/helmet": "^11.1.1",
        "@fastify/multipart": "^8.0.0",
        "@fastify/rate-limit": "^9.1.0",
        "@fastify/swagger": "^8.13.0",
        "@fastify/swagger-ui": "^2.1.0",
        "@google/generative-ai": "^0.21.0",
        "csv-parse": "^5.5.6",
        "dotenv": "^16.4.5",
        "fastify": "^4.26.2",
        "firebase-admin": "^12.6.0",
        "node-cron": "^4.2.1",
        "openai": "^4.28.0",
        "pg": "^8.11.3",
        "pino-loki": "^3.0.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/node": "^20.14.12",
        "@types/node-cron": "^3.0.11",
        "@types/pg": "^8.11.0",
        "@typescript-eslint/eslint-plugin": "^7.15.0",
        "@typescript-eslint/parser": "^7.15.0",
        "eslint": "^8.57.0",
        "pino-pretty": "^11.2.2",
        "ts-proto": "^2.11.0",
        "tsx": "^4.16.2",
        "typescript": "^5.5.4"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
