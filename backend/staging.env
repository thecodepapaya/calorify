# Staging Environment Variables
APP_NAME=CalorifyBackend-Staging
DEBUG=True
ENVIRONMENT=staging
SECRET_KEY=generate-a-secure-secret-key-staging

# Points to the 'db-staging' service defined in docker-compose.yml
DATABASE_URL=postgresql://calorify:calorify_pwd_staging@db-staging:5432/calorify_staging

# This matches the volume mount in docker-compose.yml
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
