# Optional: local overrides. Local dev loads staging.env by default.
# Use .env only to override (e.g. DATABASE_URL, FIREBASE_SERVICE_ACCOUNT_PATH).
#
# App Configuration
APP_NAME=CalorifyBackend
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=generate-a-secure-secret-key-here

# Database Configuration
# When using Docker Compose, the host should be the service name 'db-prod' or 'db-staging'
DATABASE_URL=postgresql://calorify:calorify_pwd@db:5432/calorify_db

# Firebase Configuration
# Put your service account JSON in the backend directory (e.g. firebase-adminsdk.json).
# It is gitignored; do not commit it.
# - Local dev: set in .env to override staging.env, e.g. FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-adminsdk.json
# - Docker: file is mounted as /app/firebase-service-account.json; path is set in staging.env / production.env
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# Environment
# OPTIONS: development, staging, production
ENVIRONMENT=development

# Server Configuration
PORT=8000

# Google Gemini AI
GEMINI_API_KEY=your-google-api-key-here

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

