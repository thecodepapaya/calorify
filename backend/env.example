# Optional: local overrides. Local dev loads staging.env by default.
# Use .env only to override (e.g. DATABASE_URL, FIREBASE_SERVICE_ACCOUNT_PATH).
#
# App Configuration
APP_NAME=CalorifyBackend
DEBUG=True
API_V1_STR=/api/v1
API_V2_STR=/api/v2

# Database Configuration
# When using Docker Compose, the host should be the service name 'db-prod' or 'db-staging'
DATABASE_URL=postgresql://calorify:<password>@db-staging:5432/calorify_staging
# Deployed APIs receive this from Compose and use a read-only database role.
# Local development can omit it to keep USDA tables in DATABASE_URL.
# USDA_DATABASE_URL=postgresql://calorify_usda_reader:<password>@db-usda:5432/calorify_usda
# Docker Compose interpolation (keep these consistent with DATABASE_URL for each environment).
POSTGRES_PROD_PASSWORD=<generate-a-random-production-password>
POSTGRES_STAGING_PASSWORD=<generate-a-random-staging-password>
POSTGRES_USDA_PASSWORD=<generate-a-random-usda-owner-password>
USDA_READER_PASSWORD=<generate-a-random-usda-reader-password>
GF_SECURITY_ADMIN_USER=<grafana-admin-user>
GF_SECURITY_ADMIN_PASSWORD=<generate-a-random-grafana-password>

# Firebase Configuration
# Put your service account JSON in the backend directory (e.g. firebase-adminsdk.json).
# It is gitignored; do not commit it.
# - Local dev: set in .env to override staging.env, e.g. FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-adminsdk.json
# - Docker: the entrypoint copies the read-only secret mount and exports its private runtime path.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-adminsdk.json

# Environment
# OPTIONS: development, staging, production
ENVIRONMENT=development

# Server Configuration
PORT=8000
# Nginx Proxy Manager is the single trusted hop in the deployed topology.
# Keep this unset for direct local connections.
# TRUST_PROXY=1

# OpenAI API
# Direct OpenAI is retained as the final meal-analysis fallback and is also
# required for the AI summary batch job.
OPENAI_API_KEY=your-openai-api-key-here

# OpenRouter (primary meal-analysis provider)
OPENROUTER_API_KEY=your-openrouter-api-key-here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MEAL_MODEL=openai/gpt-5-nano
# OPENROUTER_MEAL_V3_MODEL=openai/gpt-5-nano
# Required in production; choose an OpenRouter model with strict structured-output support.
# OPENROUTER_AI_SUMMARY_MODEL=openai/gpt-4.1-nano
# Uses OpenRouter's capability-aware free router (may include Nemotron and
# other currently available free models).
# OPENROUTER_FREE_MODEL=openrouter/free
# OPENROUTER_HTTP_REFERER=https://calorify.thecodepapaya.dev

# Oracle Object Storage pre-authenticated URLs. The write URL is backend-only;
# the read URL is intentionally returned to authenticated clients for meal history.
ORACLE_BUCKET_UPLOAD_URL=<oracle-pre-authenticated-upload-url>
ORACLE_BUCKET_DOWNLOAD_URL=<oracle-pre-authenticated-download-url>

# Enables the read-only /analysis-history page. Sign in with username
# "calorify" and this password. When unset, the page returns 404.
ANALYSIS_HISTORY_PASSWORD=CHANGE_ME_ANALYSIS_HISTORY_PASSWORD

# Optional: override path to meal-analysis rotating tips JSON (default: ./data/meal_analysis_tips.json under cwd).
# MEAL_ANALYSIS_TIPS_PATH=/path/to/meal_analysis_tips.json

# On-device meal-analysis rollout. Configuration is centralized in src/config.ts.
# This build and all higher build numbers receive capabilities.
LOCAL_INFERENCE_MIN_APP_BUILD=48
LOCAL_INFERENCE_TEXT_ENABLED=true
# Empty disables both local nutrition download and remote cache fill.
# Upload a new file to this same object key; clients use Last-Modified to update.
LOCAL_NUTRITION_PACK_OBJECT=local-nutrition/pack.json
