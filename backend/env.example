# App Configuration
APP_NAME=CalorifyBackend
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=generate-a-secure-secret-key-here

# Database Configuration
# When using Docker Compose, the host should be the service name 'db'
DATABASE_URL=postgresql://calorify:calorify_pwd@db:5432/calorify_db

# Firebase Configuration
# If using Strategy 2 (Docker), mount the file in docker-compose.yml
# and set the path to the internal container path.
# Example: FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# Environment
# OPTIONS: development, staging, production
ENVIRONMENT=development
